{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://feurstern.github.io/trust-forge/schemas/manifest-v0.schema.json",
  "title": "TrustForge manifest, version 0",
  "description": "The structure of a TrustForge manifest: an in-toto Statement v1 with the predicate type https://feurstern.github.io/trust-forge/manifest/v0. docs/manifest-spec.md is normative. This schema cannot express every rule (strict JSON parsing, case-variant keys, entry order, subjects matching the tree, sizes, the source URI matching the recipe, sorted features, workdir and cargoHome not containing each other), so a document that matches it can still be invalid.",
  "type": "object",
  "required": [
    "_type",
    "subject",
    "predicateType",
    "predicate"
  ],
  "properties": {
    "_type": {
      "const": "https://in-toto.io/Statement/v1"
    },
    "subject": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/subject"
      }
    },
    "predicateType": {
      "const": "https://feurstern.github.io/trust-forge/manifest/v0"
    },
    "predicate": {
      "$ref": "#/$defs/predicate"
    }
  },
  "$defs": {
    "integer": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "hex64": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "hex128": {
      "type": "string",
      "pattern": "^[0-9a-f]{128}$"
    },
    "relPath": {
      "type": "string",
      "pattern": "^(?!\\.\\.?(?:/|$))[^\\u0000-\\u001f\\u007f-\\u009f/\\\\\u061c\u200e\u200f\u202a-\u202e\u2066-\u2069\u2028\u2029\ufdd0-\ufdef\ufffe-\uffff\ud83f\udffe-\ud83f\udfff\ud87f\udffe-\ud87f\udfff\ud8bf\udffe-\ud8bf\udfff\ud8ff\udffe-\ud8ff\udfff\ud93f\udffe-\ud93f\udfff\ud97f\udffe-\ud97f\udfff\ud9bf\udffe-\ud9bf\udfff\ud9ff\udffe-\ud9ff\udfff\uda3f\udffe-\uda3f\udfff\uda7f\udffe-\uda7f\udfff\udabf\udffe-\udabf\udfff\udaff\udffe-\udaff\udfff\udb3f\udffe-\udb3f\udfff\udb7f\udffe-\udb7f\udfff\udbbf\udffe-\udbbf\udfff\udbff\udffe-\udbff\udfff]+(?:/(?!\\.\\.?(?:/|$))[^\\u0000-\\u001f\\u007f-\\u009f/\\\\\u061c\u200e\u200f\u202a-\u202e\u2066-\u2069\u2028\u2029\ufdd0-\ufdef\ufffe-\uffff\ud83f\udffe-\ud83f\udfff\ud87f\udffe-\ud87f\udfff\ud8bf\udffe-\ud8bf\udfff\ud8ff\udffe-\ud8ff\udfff\ud93f\udffe-\ud93f\udfff\ud97f\udffe-\ud97f\udfff\ud9bf\udffe-\ud9bf\udfff\ud9ff\udffe-\ud9ff\udfff\uda3f\udffe-\uda3f\udfff\uda7f\udffe-\uda7f\udfff\udabf\udffe-\udabf\udfff\udaff\udffe-\udaff\udfff\udb3f\udffe-\udb3f\udfff\udb7f\udffe-\udb7f\udfff\udbbf\udffe-\udbbf\udfff\udbff\udffe-\udbff\udfff]+)*$"
    },
    "digestSet": {
      "description": "Unknown algorithms are ignored; md5 and sha1 are never accepted.",
      "type": "object",
      "properties": {
        "blake3": {
          "$ref": "#/$defs/hex64"
        },
        "sha256": {
          "$ref": "#/$defs/hex64"
        },
        "sha512": {
          "$ref": "#/$defs/hex128"
        }
      },
      "additionalProperties": {
        "type": "string"
      },
      "anyOf": [
        {
          "required": [
            "blake3"
          ],
          "type": "object"
        },
        {
          "required": [
            "sha256"
          ],
          "type": "object"
        },
        {
          "required": [
            "sha512"
          ],
          "type": "object"
        }
      ]
    },
    "treeDigestSet": {
      "type": "object",
      "properties": {
        "narBlake3": {
          "$ref": "#/$defs/hex64"
        },
        "narSha256": {
          "$ref": "#/$defs/hex64"
        },
        "narSha512": {
          "$ref": "#/$defs/hex128"
        }
      },
      "additionalProperties": {
        "type": "string"
      },
      "anyOf": [
        {
          "required": [
            "narBlake3"
          ],
          "type": "object"
        },
        {
          "required": [
            "narSha256"
          ],
          "type": "object"
        },
        {
          "required": [
            "narSha512"
          ],
          "type": "object"
        }
      ]
    },
    "subject": {
      "type": "object",
      "required": [
        "name",
        "digest"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/relPath"
        },
        "digest": {
          "$ref": "#/$defs/digestSet"
        }
      }
    },
    "predicate": {
      "type": "object",
      "required": [
        "artifact"
      ],
      "properties": {
        "artifact": {
          "$ref": "#/$defs/artifact"
        },
        "buildDefinition": {
          "$ref": "#/$defs/buildDefinition"
        }
      }
    },
    "artifact": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "file",
            "directory"
          ]
        },
        "size": {
          "$ref": "#/$defs/integer"
        },
        "tree": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/treeEntry"
          }
        },
        "treeDigest": {
          "$ref": "#/$defs/treeDigestSet"
        }
      },
      "if": {
        "properties": {
          "kind": {
            "const": "directory"
          }
        },
        "type": "object"
      },
      "then": {
        "required": [
          "tree",
          "treeDigest"
        ],
        "type": "object"
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "tree"
              ],
              "type": "object"
            },
            {
              "required": [
                "treeDigest"
              ],
              "type": "object"
            }
          ]
        }
      }
    },
    "treeEntry": {
      "type": "object",
      "required": [
        "path",
        "type"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relPath"
        },
        "type": {
          "enum": [
            "file",
            "directory",
            "symlink"
          ]
        },
        "executable": {
          "type": "boolean"
        },
        "size": {
          "$ref": "#/$defs/integer"
        },
        "digest": {
          "$ref": "#/$defs/digestSet"
        },
        "target": {
          "type": "string",
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\\\\u061c\u200e\u200f\u202a-\u202e\u2066-\u2069\u2028\u2029\ufdd0-\ufdef\ufffe-\uffff\ud83f\udffe-\ud83f\udfff\ud87f\udffe-\ud87f\udfff\ud8bf\udffe-\ud8bf\udfff\ud8ff\udffe-\ud8ff\udfff\ud93f\udffe-\ud93f\udfff\ud97f\udffe-\ud97f\udfff\ud9bf\udffe-\ud9bf\udfff\ud9ff\udffe-\ud9ff\udfff\uda3f\udffe-\uda3f\udfff\uda7f\udffe-\uda7f\udfff\udabf\udffe-\udabf\udfff\udaff\udffe-\udaff\udfff\udb3f\udffe-\udb3f\udfff\udb7f\udffe-\udb7f\udfff\udbbf\udffe-\udbbf\udfff\udbff\udffe-\udbff\udfff]+$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "file"
              }
            },
            "type": "object"
          },
          "then": {
            "required": [
              "executable",
              "size",
              "digest"
            ],
            "not": {
              "required": [
                "target"
              ],
              "type": "object"
            },
            "type": "object"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "symlink"
              }
            },
            "type": "object"
          },
          "then": {
            "required": [
              "target"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "executable"
                  ],
                  "type": "object"
                },
                {
                  "required": [
                    "size"
                  ],
                  "type": "object"
                },
                {
                  "required": [
                    "digest"
                  ],
                  "type": "object"
                }
              ]
            },
            "type": "object"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "directory"
              }
            },
            "type": "object"
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "executable"
                  ],
                  "type": "object"
                },
                {
                  "required": [
                    "size"
                  ],
                  "type": "object"
                },
                {
                  "required": [
                    "digest"
                  ],
                  "type": "object"
                },
                {
                  "required": [
                    "target"
                  ],
                  "type": "object"
                }
              ]
            }
          }
        }
      ]
    },
    "buildDefinition": {
      "description": "Build types other than cargo/v0 are not interpreted by this version.",
      "type": "object",
      "required": [
        "buildType"
      ],
      "properties": {
        "buildType": {
          "type": "string"
        }
      },
      "if": {
        "properties": {
          "buildType": {
            "const": "https://feurstern.github.io/trust-forge/build/cargo/v0"
          }
        },
        "type": "object"
      },
      "then": {
        "$ref": "#/$defs/cargoBuildDefinition"
      }
    },
    "cargoName": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,63}$"
    },
    "cargoBuildDefinition": {
      "required": [
        "externalParameters",
        "internalParameters",
        "resolvedDependencies"
      ],
      "properties": {
        "externalParameters": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "bin",
            "target",
            "outputPath"
          ],
          "properties": {
            "source": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "repository"
              ],
              "properties": {
                "repository": {
                  "type": "string",
                  "maxLength": 2048,
                  "pattern": "^https://[A-Za-z0-9][A-Za-z0-9.-]*(?::[0-9]{1,5})?(?:/(?!\\.\\.?(?:/|$))[!-\"$&-.0->A-\\[\\]-~]+)*$"
                },
                "ref": {
                  "type": "string",
                  "maxLength": 255,
                  "pattern": "^refs/(?![/.])(?!.*\\.\\.)(?!.*//)(?!.*/\\.)(?!.*\\.lock(?:/|$))(?!.*[/.]$)[!-)+-9;->A-Z\\]_-}]+$"
                }
              }
            },
            "workspacePath": {
              "$ref": "#/$defs/recipePath"
            },
            "package": {
              "$ref": "#/$defs/cargoName"
            },
            "bin": {
              "$ref": "#/$defs/cargoName"
            },
            "profile": {
              "$ref": "#/$defs/cargoName"
            },
            "target": {
              "type": "string",
              "maxLength": 64,
              "pattern": "^(?!.*\\.json$)[a-z0-9_]+(?:-[a-z0-9_.]+){1,4}$"
            },
            "features": {
              "description": "Sorted and unique.",
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_][A-Za-z0-9_+.-]{0,63}$"
              }
            },
            "defaultFeatures": {
              "type": "boolean"
            },
            "outputPath": {
              "$ref": "#/$defs/recipePath"
            }
          }
        },
        "internalParameters": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "toolchain"
          ],
          "properties": {
            "toolchain": {
              "type": "string",
              "pattern": "^(?:[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}|(?:nightly|beta)-[0-9]{4}-[0-9]{2}-[0-9]{2})$"
            },
            "workdir": {
              "$ref": "#/$defs/containerPath"
            },
            "cargoHome": {
              "$ref": "#/$defs/containerPath"
            },
            "env": {
              "type": "object",
              "propertyNames": {
                "pattern": "^(?:SOURCE_DATE_EPOCH|RUSTFLAGS|CARGO_PROFILE_[A-Z0-9_]+)$",
                "type": "string"
              },
              "additionalProperties": {
                "type": "string"
              },
              "properties": {
                "SOURCE_DATE_EPOCH": {
                  "type": "string",
                  "pattern": "^[0-9]{1,19}$"
                }
              }
            }
          }
        },
        "resolvedDependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resourceDescriptor"
          },
          "allOf": [
            {
              "contains": {
                "properties": {
                  "uri": {
                    "pattern": "^[Gg][Ii][Tt]\\+",
                    "type": "string"
                  }
                },
                "type": "object"
              },
              "maxContains": 1,
              "type": "array"
            },
            {
              "contains": {
                "properties": {
                  "uri": {
                    "pattern": "^git\\+",
                    "type": "string"
                  },
                  "digest": {
                    "required": [
                      "gitCommit"
                    ],
                    "properties": {
                      "gitCommit": {
                        "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
                        "type": "string"
                      }
                    },
                    "type": "object"
                  }
                },
                "type": "object"
              },
              "type": "array"
            },
            {
              "contains": {
                "properties": {
                  "uri": {
                    "pattern": "^[Pp][Kk][Gg]:[Dd][Oo][Cc][Kk][Ee][Rr]/",
                    "type": "string"
                  }
                },
                "type": "object"
              },
              "maxContains": 1,
              "type": "array"
            },
            {
              "contains": {
                "properties": {
                  "uri": {
                    "pattern": "^pkg:docker/",
                    "type": "string"
                  },
                  "digest": {
                    "required": [
                      "sha256"
                    ],
                    "properties": {
                      "sha256": {
                        "$ref": "#/$defs/hex64"
                      }
                    },
                    "type": "object"
                  }
                },
                "type": "object"
              },
              "type": "array"
            }
          ]
        }
      },
      "type": "object"
    },
    "resourceDescriptor": {
      "type": "object",
      "required": [
        "uri",
        "digest"
      ],
      "properties": {
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "name": {
          "type": "string"
        }
      }
    },
    "recipePath": {
      "description": "A relative path passed to Cargo: every component starts with an ASCII letter, digit or '_'.",
      "type": "string",
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9_+.-]*(?:/[A-Za-z0-9_][A-Za-z0-9_+.-]*)*$"
    },
    "containerPath": {
      "description": "An absolute path in the build container, under /build/. workdir and cargoHome must not contain each other, which this schema cannot express.",
      "type": "string",
      "pattern": "^/build(?:/[A-Za-z0-9_][A-Za-z0-9_.-]*)+$"
    }
  }
}
